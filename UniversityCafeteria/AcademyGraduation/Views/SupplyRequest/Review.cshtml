@model List<OfferInfo>
@{
    ViewData["Title"] = "Review Request";
}

<h1>Review Request</h1>

<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Supplier</th>
            <th>Offer</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total Price</th>
            <th>Discount %</th>
            <th>Discount Amount</th>
            <th>Final Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var offer in Model)
        {
            <tr>
                <td>@offer.CategoryName</td>
                <td>@offer.SupplierName</td>
                <td>@offer.OfferName</td>
                <td>@offer.Quantity</td>
                <td>@offer.UnitPrice JD</td>
                <td>@offer.TotalPrice JD</td>
                <td>@offer.DiscountPercent %</td>
                <td>@offer.DiscountAmount JD</td>
                <td>@offer.FinalTotal JD</td>
            </tr>
        }
    </tbody>
</table>

<p>Total Price: @ViewBag.GrandTotal JD</p>
<p>Total Discount: @ViewBag.TotalDiscount JD</p>
<h4>Final Total: @ViewBag.FinalTotal JD</h4>

<a asp-action="Create" class="btn btn-secondary">Change Selection</a>

@model List<UniversityCafeteria.Models.SupplyRequest>

@{
    ViewData["Title"] = "Supply Requests";
    var userNames = (Dictionary<string, string?>)ViewBag.UserNames;
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}

<h1>@(isAdmin ? "All Supply Requests" : "My Supply Requests")</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create">New Supply Request</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Date</th>
            @if (isAdmin)
            {
                <th>User</th>
            }
            <th>Total Price</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                @if (isAdmin)
                {
                    <td>@(item.UserId != null && userNames.ContainsKey(item.UserId) ? userNames[item.UserId] : "")</td>
                }
                <td>@item.TotalPrice.ToString("0.00")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    @if (isAdmin || item.Status == "Pending")
                    {
                        <span>|</span>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <span>|</span>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                            <input type="submit" value="Delete" class="btn btn-link p-0 align-baseline" onclick="return confirm('Are you sure you want to delete this request?');" />
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

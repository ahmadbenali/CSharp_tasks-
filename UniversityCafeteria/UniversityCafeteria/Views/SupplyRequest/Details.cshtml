@model UniversityCafeteria.Models.SupplyRequest
@using UniversityCafeteria.Models

@{
    ViewData["Title"] = "Request Details";
    var items = (List<RequestItem>)ViewBag.Items;
}

<h1>Request #@Model.Id</h1>

<dl class="row">
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    <dt class="col-sm-2">User</dt>
    <dd class="col-sm-10">@ViewBag.UserName</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>
    <dt class="col-sm-2">Total Price</dt>
    <dd class="col-sm-10">@Model.TotalPrice.ToString("0.00")</dd>
</dl>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Price.ToString("0.00")</td>
                <td>@item.Quantity</td>
                <td>@((item.Price * item.Quantity).ToString("0.00"))</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Requests">Back to list</a>

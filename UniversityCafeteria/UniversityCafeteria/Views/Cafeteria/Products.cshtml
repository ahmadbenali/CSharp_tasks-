*@
@{
        string[] productNames = { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate"};
        //string[] productNames = { };
        
}

@section Styles{
    <link rel="stylesheet" href="~/css/products.css" /> 
}

<div class="container">
    <h1>Products</h1>
    @if (productNames.Length == 0)
    {
        <p>We need More Products.</p>
    }
    else if (productNames.Length >=3)
    {
        <p>We have enough Products:</p>
        <ul>
            @foreach (var productName in productNames)
            {
                <li>@productName</li>
            }
        </ul>
    }

 
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            alert("Welcome to the Products Page!");
        });
    </script>
}




@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Users";
    var users = (List<IdentityUser>)ViewBag.Users;
    var userRoles = (Dictionary<string, string>)ViewBag.UserRoles;
}

<h1>Users</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in users)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@userRoles[user.Id]</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id">Change Role</a> |
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline">
                        <input type="submit" value="Delete" class="btn btn-link p-0 align-baseline" onclick="return confirm('Are you sure you want to delete this user?');" />
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
